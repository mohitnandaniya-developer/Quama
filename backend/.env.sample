# Backend environment sample - only variables referenced by `backend/app/config.py`.
# Copy the sections you need into `.env.local` (development) or `.env` (production).

# LLM Providers
# OpenAI API key (chat + vision)
OPENAI_API_KEY=
# Google Gemini API key
GOOGLE_API_KEY=
# Groq API key
GROQ_API_KEY=

# NewsAPI.ai MCP key.
# Backend owns this key and never exposes it to frontend.
NEWS_API_KEY=

# Cache / Session (Redis / Upstash)
UPSTASH_REDIS_REST_URL=

# Database
# Render/Postgres URLs using postgresql:// or postgres:// are normalized at startup.
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/quama

# Clerk / Authentication (optional)
CLERK_JWKS_URL=
CLERK_JWT_KEY=
CLERK_ISSUER=
CLERK_AUTHORIZED_PARTIES=
CLERK_JWKS_CACHE_TTL_SECONDS=300

# Broker (Angel One)
ANGEL_ONE_API_KEY=
ANGEL_ONE_SECRET_KEY=
BROKER_TOKEN_SECRET=
DEFAULT_BROKER=angel_one

# Cache TTLs
BROKER_JWT_CACHE_TTL_SECONDS=82800
PORTFOLIO_CACHE_TTL_SECONDS=60
MARKET_SNAPSHOT_TTL_SECONDS=30
MARKET_SUBSCRIPTION_TTL_SECONDS=3600
CHAT_HISTORY_CACHE_TTL_SECONDS=3600
MCP_CONNECTION_TTL_SECONDS=2592000

# Market Worker
MARKET_WORKER_POLL_INTERVAL_SECONDS=5
ANGEL_ONE_PRICE_SCALE=100.0

# App Settings
DEBUG=false
# Comma-delimited frontend origins, without trailing paths.
ALLOWED_ORIGINS=http://localhost:3000

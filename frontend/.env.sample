# Frontend environment sample - only variables referenced by the frontend code.
# Copy values into `.env.local` for development and set real values in `.env` for production.

# Backend API
VITE_API_BASE_URL=http://127.0.0.1:8000

# Local Debug (optional): set only when the backend uses DEBUG=true.
# Leave empty to require Clerk sign-in.
VITE_CHAT_USER_ID=

# Clerk
VITE_CLERK_PUBLISHABLE_KEY=
# Server-side only. Configure in Vercel without a VITE_ prefix.
CLERK_SECRET_KEY=
